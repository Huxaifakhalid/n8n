    {
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\nconst body = input.body ?? input;\nconst message = body.message ?? {};\n\nconst toolCall =\n  message.toolCallList?.[0] ??\n  message.toolCalls?.[0] ??\n  {};\n\nlet args =\n  toolCall.function?.['arguments'] ??\n  toolCall['arguments'] ??\n  body;\n\nif (typeof args === 'string') {\n  args = JSON.parse(args);\n}\n\nfunction preserveTimezone(value) {\n  if (!value) return '';\n\n  // Keep an existing timezone offset or Z unchanged.\n  // Add +05:00 only if the timestamp has no timezone.\n  if (/[+-]\\d{2}:\\d{2}$/.test(value) || /Z$/i.test(value)) {\n    return value;\n  }\n\n  return value + '+05:00';\n}\n\nreturn [{\n  json: {\n    toolCallId: toolCall.id ?? '',\n    patientName: args.patientName ?? '',\n    dateOfBirth: args.dateOfBirth ?? '',\n    phone: args.phone ?? '',\n    email: args.email ?? '',\n    appointmentType: args.appointmentType ?? '',\n    provider: args.provider ?? '',\n    start: preserveTimezone(args.start ?? ''),\n    end: preserveTimezone(args.end ?? '')\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        112
      ],
      "id": "6125c016-4698-4628-a68c-1faac878c829",
      "name": "Parse Vapi Data"
    },
    {
      "parameters": {
        "jsCode": "const events = $input.all();\n\n// If any event has a real ID, slot is taken\nconst slotTaken = events.some(item => item.json && item.json.id);\n\nreturn [{\n  json: {\n    slotAvailable: !slotTaken\n  }\n}];"
      },
