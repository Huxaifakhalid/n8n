    {
      "parameters": {
        "jsCode": "\nconst calendarItems = $('Get many events').all();\nconst data = $('parse VAPI data').first().json;\n\n// Match the existing appointment using its original start time\nconst oldStart = new Date(data.oldStart).getTime();\n\nif (!Number.isFinite(oldStart)) {\n  throw new Error(\"Invalid oldStart date.\");\n}\n\nconst matchingEvents = calendarItems.filter(item => {\n  const event = item.json;\n\n  const eventStart =\n    event.start?.dateTime ??\n    event.start?.date;\n\n  if (!event.id || !eventStart) return false;\n\n  const eventTime = new Date(eventStart).getTime();\n\n  return eventTime === oldStart &&\n    (event.summary ?? \"\").toLowerCase()\n      .includes(data.patientName.toLowerCase());\n});\n\nif (matchingEvents.length !== 1) {\n  throw new Error(\n    `Expected exactly one matching event, found ${matchingEvents.length}.`\n  );\n}\n\nconst event = matchingEvents[0].json;\n\nreturn [{\n  json: {\n    eventId: event.id,\n    patientName: data.patientName,\n    phone: data.phone,\n    oldStart: data.oldStart,\n    newStart: data.newStart,\n    newEnd: data.newEnd,\n    sheetNewStart: data.sheetNewStart,\n    sheetNewEnd: data.sheetNewEnd\n  }\n}];\n"
      },
