    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst toolCallId = body.message?.toolCallList?.[0]?.id || body.message?.toolCalls?.[0]?.id || \"test_id\";\nlet args = body.message?.toolCallList?.[0]?.function?.arguments || body.message?.toolCalls?.[0]?.function?.arguments || body;\nif (typeof args === 'string') { try { args = JSON.parse(args); } catch(e) { args = {}; } }\n\nconst oldStartRaw = args.oldStart || \"\";\nconst newStartRaw = args.newStart || \"\";\nconst newEndRaw = args.newEnd || \"\";\n\n// Convert ISO strings (\"2026-09-19T10:00:00+05:00\") into Google Sheet space-separated format (\"2026-09-19 10:00:00\")\nconst formatForSheet = (isoStr) => {\n  if (!isoStr) return \"\";\n  return isoStr.replace('T', ' ').split('+')[0].split('Z')[0].substring(0, 19);\n};\n\nreturn [{\n  json: {\n    toolCallId,\n    patientName: args.patientName || \"\",\n    phone: args.phone || \"\",\n    oldStart: oldStartRaw, // Kept for Google Calendar\n    newStart: newStartRaw, // Kept for Google Calendar\n    newEnd: newEndRaw,\n    sheetNewStart: formatForSheet(newStartRaw), // Handled for Google Sheets\n    sheetNewEnd: formatForSheet(newEndRaw)\n  }\n}];"
      },
