      "parameters": {
        "jsCode": "// Get raw LLM output\nlet text = $input.item.json.output || \"\";\n\n// Remove any leading name pattern (e.g., \"Ali Test, \", \"Dear Ali Test, \", \"Ali, \")\ntext = text.replace(/^({{\\ $('Webhook').item.json.body.name }}|Dear\\s+.*?,?|.*?,)\\s*/i, '');\n\n// Capitalize the first letter of the remaining text\ntext = text.charAt(0).toUpperCase() + text.slice(1);\n\nreturn [{ json: { cleanBody: text } }];"
      },
