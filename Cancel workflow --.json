    {
      "parameters": {
        "jsCode": "const data = $('Parse Vapi Data').first().json;\nconst rows = $('Get row(s) in sheet').all().map(x=>x.json).filter(x=>x['Full Name']);\nconst requestedStart = Date.parse(data.start);\nconst normalizePhone = v => String(v ?? '').replace(/\\D/g,'').replace(/^0+/, '');\nconst matchesSheet = rows.filter(row => {\n  const local = String(row['Start'] ?? '').trim().replace(' ','T');\n  const sheetTime = Date.parse(/[Zz]$|[+-]\\d{2}:\\d{2}$/.test(local) ? local : local+'+05:00');\n  return String(row['Full Name']??'').trim().toLowerCase() === data.patientName.toLowerCase()\n    && normalizePhone(row['Phone Number']) === normalizePhone(data.phone)\n    && sheetTime === requestedStart\n    && String(row['Status']??'').toLowerCase() !== 'cancelled';\n});\nif(matchesSheet.length !== 1) throw new Error(`Expected one exact active Sheet appointment, found ${matchesSheet.length}; no deletion.`);\nconst events = $('Get many events').all().map(x=>x.json);\nconst matches = events.filter(event => event.id && event.start?.dateTime &&\n  Date.parse(event.start.dateTime) === requestedStart &&\n  String(event.summary??'').toLowerCase().includes(data.patientName.toLowerCase()) &&\n  event.eventType !== 'birthday');\nif(matches.length !== 1) throw new Error(`Expected one exact Calendar appointment, found ${matches.length}; no deletion.`);\nreturn [{json:{eventId:matches[0].id,row_number:matchesSheet[0].row_number,patientName:data.patientName,phone:data.phone,start:data.start,end:data.end,toolCallId:data.toolCallId}}];"
      },
