    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst call = body.message?.toolCallList?.[0] ?? body.message?.toolCalls?.[0] ?? {};\nlet args = call.function?.['arguments'] ?? call['arguments'] ?? body;\nif (typeof args === 'string') args = JSON.parse(args);\nconst start = String(args.start ?? args.appointmentStart ?? '');\nconst end = String(args.end ?? '');\nif (!start || !end || !Number.isFinite(Date.parse(start)) || !Number.isFinite(Date.parse(end))) {\n  throw new Error('Cancellation requires valid start and end ISO timestamps with timezone.');\n}\nif (Date.parse(end) <= Date.parse(start)) throw new Error('End must be after start');\nif (!args.patientName || !args.phone) throw new Error('Missing patient name or phone');\nreturn [{json:{toolCallId: call.id ?? '',patientName:String(args.patientName).trim(),phone:String(args.phone).trim(),appointmentDate:start.slice(0,10),start,end}}];"
      },
